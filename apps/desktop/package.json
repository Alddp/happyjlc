  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/three": "^0.185.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
